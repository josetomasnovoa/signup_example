    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
